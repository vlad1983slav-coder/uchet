# Скопируйте в .env и заполните — приложение читает .env автоматически (app/Core/helpers.php::env()).
# На VDS можно вместо этого задать настоящие переменные окружения или SetEnv в .htaccess.

APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Asia/Krasnoyarsk

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uchet
DB_USERNAME=root
DB_PASSWORD=
