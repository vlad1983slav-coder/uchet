# Скопируйте в .env (или задайте переменные окружения):
# cp .env.example .env
# и подключайте значения в config/config.php через getenv() — он уже читает эти ключи.

APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Asia/Krasnoyarsk

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uchet
DB_USERNAME=root
DB_PASSWORD=
